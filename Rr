def ddp_main(rank: int, world_size: int, args):
    """Entry point for DistributedDataParallel."""
    dist.init_process_group("nccl" if torch.cuda.is_available() else "gloo",
                            rank=rank, world_size=world_size)
    torch.cuda.set_device(rank)
    device = torch.device(f'cuda:{rank}')
    # Build simulator
    sim = SSCSimulator(N_particles=args.N, XMIN=-5, XMAX=5, NGRID=512, device=device)
    trainer = RHTrainer(sim, device=device, use_ddp=True)
    trainer.train(epochs=args.epochs, num_sim_steps=args.steps, batch_size=args.batch_size)
    dist.destroy_process_group()

